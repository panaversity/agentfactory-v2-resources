{
  "name": "brightline-ap",
  "version": "0.15.0",
  "private": true,
  "type": "module",
  "description": "Brightline Wholesale Supply, accounts payable scripts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:py": "cd py && uv run pytest",
    "check:py": "cd py && uv run pyright && uv run ruff check",
    "vendors": "node src/list-vendors.ts",
    "due": "node src/due-by-friday.ts",
    "reconcile": "node src/reconcile.ts",
    "check-invoices": "node src/load-invoices.ts",
    "export-json": "node src/export-json.ts",
    "api": "node --env-file-if-exists=.env scripts/ap-api.ts",
    "fetch-ap": "node --env-file=.env src/ap-client.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
