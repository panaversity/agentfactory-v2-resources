{
  "name": "@brightline/review-ts",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --env-file-if-exists=../../.secrets/test-signing.local.env --env-file-if-exists=../../.secrets/db.dev.env --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "start": "node --env-file-if-exists=.dev.vars --env-file-if-exists=../../.secrets/test-signing.local.env --env-file=../../.secrets/db.dev.env src/node.ts 8757",
    "dev:staging": "wrangler dev --env staging --ip 127.0.0.1 --port 8757",
    "deploy:staging": "node ../../scripts/check-deploy.ts --ready staging && wrangler deploy --env staging",
    "check:deploy": "wrangler deploy --dry-run --env staging --outdir .wrangler/dry-run-staging"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "wrangler": "4.156.1"
  }
}
