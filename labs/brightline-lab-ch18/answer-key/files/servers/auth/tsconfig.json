{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "test", "scripts"]
}
