{
  "name": "brightline-ap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:py": "cd py && uv run --locked pytest -q",
    "check:py": "cd py && uv run --locked pyright",
    "check:plugin": "node scripts/check-plugin.ts",
    "hello": "npm --workspace @brightline/hello start",
    "hello-auth": "npm --workspace @brightline/hello-auth start",
    "test:hello-auth": "npm --workspace @brightline/hello-auth test",
    "test:servers": "npm --workspace @brightline/ap-ts test",
    "conformance": "node scripts/conformance.ts",
    "keys": "node scripts/make-keys.ts",
    "conformance:staging": "node --env-file=.secrets/staging.env --env-file=.secrets/staging.urls.env scripts/conformance.ts",
    "conformance:production": "node --env-file=.secrets/production.env --env-file=.secrets/production.urls.env scripts/conformance.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.13",
    "@modelcontextprotocol/inspector": "2.13.0",
    "@modelcontextprotocol/client": "2.4.0"
  },
  "workspaces": [
    "servers/hello",
    "servers/hello-auth",
    "servers/ap-ts"
  ]
}
